{
  "name": "@agntia/ciberseguridad",
  "version": "0.1.0-alpha.3",
  "private": true,
  "type": "module",
  "description": "Server-only typed middleware client",
  "exports": {
    ".": "./dist/client.js",
    "./hono": "./dist/hono.js",
    "./agent-tools": "./dist/agent-tools.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test --test-isolation=none test/*.test.mjs",
    "pack:deterministic": "npm run build && node scripts/pack.mjs",
    "provenance:write": "npm run build && node scripts/provenance.mjs --write",
    "provenance:check": "npm run build && node scripts/provenance.mjs --check"
  },
  "dependencies": {
    "hono": "4.13.18"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md",
    "PROVENANCE.json"
  ],
  "license": "UNLICENSED"
}
