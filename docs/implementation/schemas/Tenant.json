{
  "additionalProperties": false,
  "properties": {
    "id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
      "title": "Id",
      "type": "string"
    },
    "name": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "timezone": {
      "default": "UTC",
      "maxLength": 64,
      "title": "Timezone",
      "type": "string"
    }
  },
  "required": [
    "id",
    "name"
  ],
  "title": "Tenant",
  "type": "object"
}
