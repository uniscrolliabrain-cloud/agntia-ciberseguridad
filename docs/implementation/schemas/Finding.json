{
  "additionalProperties": false,
  "properties": {
    "evidence_ids": {
      "items": {
        "pattern": "^[a-f0-9]{32}$",
        "type": "string"
      },
      "maxItems": 100,
      "title": "Evidence Ids",
      "type": "array"
    },
    "fingerprint": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Fingerprint",
      "type": "string"
    },
    "id": {
      "pattern": "^[a-f0-9]{32}$",
      "title": "Id",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-f0-9]{32}$",
      "title": "Job Id",
      "type": "string"
    },
    "rule_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Rule Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "severity": {
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical",
        "unknown"
      ],
      "title": "Severity",
      "type": "string"
    },
    "state": {
      "default": "unverified",
      "enum": [
        "unverified",
        "confirmed",
        "false_positive",
        "resolved"
      ],
      "title": "State",
      "type": "string"
    },
    "tenant_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
      "title": "Tenant Id",
      "type": "string"
    },
    "title": {
      "maxLength": 300,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "tool_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
      "title": "Tool Id",
      "type": "string"
    },
    "tool_version": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Tool Version",
      "type": "string"
    }
  },
  "required": [
    "id",
    "tenant_id",
    "job_id",
    "fingerprint",
    "rule_id",
    "tool_id",
    "tool_version",
    "severity",
    "title"
  ],
  "title": "Finding",
  "type": "object"
}
