{
  "$defs": {
    "AssetKind": {
      "enum": [
        "repository",
        "directory",
        "image",
        "web"
      ],
      "title": "AssetKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "display_name": {
      "maxLength": 160,
      "minLength": 2,
      "title": "Display Name",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/AssetKind"
    },
    "target_ref": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
      "title": "Target Ref",
      "type": "string"
    }
  },
  "required": [
    "target_ref",
    "kind",
    "display_name"
  ],
  "title": "AssetCreate",
  "type": "object"
}
