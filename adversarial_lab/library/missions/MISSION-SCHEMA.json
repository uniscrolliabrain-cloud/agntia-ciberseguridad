{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agntia.example/schemas/mission-v1.json",
  "title": "Adversarial Lab mission",
  "type": "object",
  "required": ["schema_version", "id", "title", "scope_kind", "required_capabilities", "limits", "stop_conditions", "hypotheses"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^(api|repo|ai|resilience)-[a-z0-9-]+$"},
    "title": {"type": "string", "minLength": 3},
    "scope_kind": {"enum": ["repo", "api", "model", "container"]},
    "required_capabilities": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "technique_tags": {"type": "array", "items": {"type": "string"}},
    "limits": {
      "type": "object",
      "required": ["max_duration_seconds"],
      "properties": {
        "max_duration_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
        "max_requests": {"type": "integer", "minimum": 1, "maximum": 1000},
        "max_cost_cents": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "stop_conditions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "hypotheses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["statement", "disproof"],
        "properties": {"statement": {"type": "string"}, "disproof": {"type": "string"}},
        "additionalProperties": false
      }
    }
  }
}
