{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "synthetic_shop twin",
  "type": "object",
  "required": ["users.json", "orders.json"],
  "properties": {
    "users.json": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "email", "role"],
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "email": {"type": "string", "pattern": "@example\\.invalid$"},
          "role": {"enum": ["customer", "support", "admin"]}
        }
      }
    },
    "orders.json": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "user_id", "total_cents", "status"],
        "properties": {
          "id": {"type": "string"},
          "user_id": {"type": "string"},
          "total_cents": {"type": "integer", "minimum": 0},
          "status": {"enum": ["created", "paid", "shipped", "refunded"]}
        }
      }
    }
  }
}
